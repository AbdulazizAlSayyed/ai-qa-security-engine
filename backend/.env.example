# Copy to backend/.env and fill in. Never commit the real .env.
# Every value below is optional - the defaults in app/core/config.py match
# a standard local install, so an empty .env still boots.

# --- MongoDB ---------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_qa_security

# --- Backend server --------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Frontend (drives the CORS allow-list) ---------------------------
FRONTEND_URL=http://localhost:5173

# --- AI analysis (Phase 5) -------------------------------------------
# Analysis runs only when a user clicks "Analyze Assessment". Without a key
# and a model it fails with a clear configuration error; nothing else breaks.
# AI_PROVIDER picks which section below is used: "openai" or "gemini".
AI_PROVIDER=openai
# Your own key. Placeholder only - never put a real key in this file.
OPENAI_API_KEY=
# A chat model your key can use. Intentionally no default.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=1

# Alternative provider (AI_PROVIDER=gemini). Get a key at
# https://aistudio.google.com/apikey - the free tier needs no card.
# Your own key. Placeholder only - never put a real key in this file.
GEMINI_API_KEY=
# Intentionally no default. As of Sep 2026, gemini-2.5-flash-lite is
# retired for new API keys; gemini-3.5-flash-lite is the free tier's
# current highest-throughput model (30 req/min). Check
# https://ai.google.dev/gemini-api/docs/models for the latest name.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=90

AI_MAX_OUTPUT_TOKENS=8000
AI_MAX_EVIDENCE_ITEMS=300
AI_MAX_CONTEXT_CHARS=60000
AI_ANALYSIS_STALE_SECONDS=600

# --- Correlation & prioritization (Phase 6, deterministic, no AI call) -
CORRELATION_STALE_SECONDS=300

# --- Recommendations (Phase 8, advisory only, via AIAnalysisService) ----
RECOMMENDATION_MAX_ISSUES=50

# --- Retest (Phase 9, re-runs existing engines, no AI) ----------------
RETEST_STALE_SECONDS=1800

# --- Reports (Phase 10, read-only assembly; files under REPORTS_ROOT) --
REPORT_STALE_SECONDS=600

# --- QA engine (Playwright) ------------------------------------------
QA_HEADLESS=true
# Blank uses Playwright's bundled Chromium. "chrome" or "msedge" drive a
# locally installed browser instead.
QA_BROWSER_CHANNEL=
QA_NAVIGATION_TIMEOUT_MS=15000
QA_TEST_TIMEOUT_MS=30000

# --- Security engine -------------------------------------------------
SECURITY_ENABLED=true
# Budget handed to each external scanner, in seconds.
SECURITY_TIMEOUT_SECONDS=180

# OWASP ZAP runs as its own native process and is reached over its REST API.
# Port 8090 rather than ZAP's 8080 default, which is commonly already taken.
# Start it with:
#   <zap-home>\zap.bat -daemon -host 127.0.0.1 -port 8090 -config api.key=YOUR_KEY
ZAP_ENABLED=true
ZAP_HOST=127.0.0.1
ZAP_PORT=8090
# Generate your own; never commit a real key.
ZAP_API_KEY=
# Absolute path to zap.bat / zap.sh. Leave blank if ZAP is already running.
ZAP_EXECUTABLE=
ZAP_SPIDER=true
ZAP_SPIDER_MAX_CHILDREN=10

# Custom API probes. Safe methods only (GET/HEAD/OPTIONS).
API_PROBES_ENABLED=true
API_PROBE_TIMEOUT_SECONDS=10
# Local targets routinely use self-signed certificates.
API_PROBE_VERIFY_TLS=false

# Semgrep is optional; a scan succeeds whether or not it is installed.
SEMGREP_ENABLED=true
SEMGREP_EXECUTABLE=semgrep
SEMGREP_RULESET=p/security-audit

# --- Workspaces ------------------------------------------------------
# Leave blank to use backend/.qa-workspace
QA_WORKSPACE_ROOT=

# --- Logging ---------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
