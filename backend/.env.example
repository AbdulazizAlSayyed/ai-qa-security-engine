# Copy to backend/.env and fill in. Never commit the real .env.
# Every value below is optional - the defaults in app/core/config.py match
# a standard local install, so an empty .env still boots.

# --- MongoDB ---------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_qa_security

# --- Backend server --------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Frontend (drives the CORS allow-list) ---------------------------
FRONTEND_URL=http://localhost:5173

# --- AI provider (used from Phase 5) ---------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# --- OWASP ZAP (used from Phase 3) -----------------------------------
ZAP_API_URL=http://127.0.0.1:8080
ZAP_API_KEY=

# --- Workspaces ------------------------------------------------------
# Leave blank to use backend/.qa-workspace
QA_WORKSPACE_ROOT=

# --- Logging ---------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
